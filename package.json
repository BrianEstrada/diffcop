{
  "name": "diffcop",
  "version": "0.2.0",
  "description": "An opinionated, local-first AI code reviewer that runs on the coding agent you already use.",
  "keywords": [
    "ai",
    "claude-code",
    "cli",
    "code-review"
  ],
  "homepage": "https://github.com/BrianEstrada/diffcop#readme",
  "bugs": "https://github.com/BrianEstrada/diffcop/issues",
  "license": "MIT",
  "author": "Brian Estrada",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrianEstrada/diffcop.git"
  },
  "bin": {
    "diffcop": "src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "tsconfig.json"
  ],
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "scripts": {
    "diffcop": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun test --pass-with-no-tests",
    "changelog": "if grep -qF \"## [$npm_package_version]\" CHANGELOG.md; then echo \"CHANGELOG.md already has $npm_package_version\"; exit 1; fi; git-cliff --unreleased --tag v$npm_package_version --prepend CHANGELOG.md && oxfmt CHANGELOG.md",
    "release-notes": "git-cliff --unreleased --strip all"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.148",
    "@ai-sdk/harness-claude-code": "1.0.152",
    "@ai-sdk/provider-utils": "5.0.58",
    "@octokit/core": "7.0.8",
    "@octokit/plugin-paginate-rest": "16.0.0",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/request-error": "7.1.2",
    "ai": "7.0.137",
    "ai-sdk-sandbox-local": "0.1.2",
    "citty": "0.2.2",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "1.4.2",
    "git-cliff": "2.14.2",
    "lefthook": "2.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-deslopify": "0.5.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  }
}
